{
  "manifest_version": 3,
  "name": "Div Inspector",
  "version": "1.0.0",
  "description": "Hover to highlight elements. S for CSS details, A to ask local AI and live-preview its CSS fixes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Div Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:11434/*", "http://127.0.0.1:11434/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" }
    }
  }
}
